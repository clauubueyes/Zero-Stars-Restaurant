# Normalize text in Git and on checkout to avoid platform-only diffs.
* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.txt text eol=lf
*.wlt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
